# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-photos
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# CDN (Cloudflare — public image delivery)
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Auth (single admin — no users table)
# Generate hash: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$...
JWT_SECRET=generate-a-random-64-plus-character-string-here-for-signing-session-cookies
